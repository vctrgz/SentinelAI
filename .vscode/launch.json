{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "▶ SentinelAI: Servidor Web",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "args": [
                "app.server:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/sentinel",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/sentinel"
            },
            "jinja": true,
            "justMyCode": false,
            "preLaunchTask": "SentinelAI: Setup Entorno",
            "serverReadyAction": {
                "pattern": "Application startup complete",
                "uriFormat": "http://localhost:8000",
                "action": "openExternally"
            }
        },
        {
            "name": "⌨ SentinelAI: CLI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/sentinel/app/main.py",
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}/sentinel",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/sentinel"
            },
            "console": "integratedTerminal",
            "justMyCode": false,
            "preLaunchTask": "SentinelAI: Setup Entorno"
        },
        {
            "name": "🧪 SentinelAI: Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "args": [
                "tests/",
                "-v",
                "--tb=short",
                "--no-header"
            ],
            "cwd": "${workspaceFolder}/sentinel",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/sentinel"
            },
            "console": "integratedTerminal",
            "justMyCode": false,
            "preLaunchTask": "SentinelAI: Setup Entorno"
        }
    ]
}