{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SentinelAI: Ejecutar Servidor",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--host", "0.0.0.0",
                "--port", "8000"
            ],
            "cwd": "${workspaceFolder}/sentinel",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/sentinel"
            },
            "jinja": true,
            "justMyCode": true
        }
    ]
}