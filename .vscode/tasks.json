{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SentinelAI: Setup Entorno",
            "type": "process",

            // Usa el Python del SISTEMA (no del venv) porque el venv
            // puede no existir todavía cuando se ejecuta esta tarea.
            // VSCode resolverá el Python correcto según el intérprete configurado.
            "command": "python",
            "args": [
                "${workspaceFolder}/sentinel/setup_env.py"
            ],

            "options": {
                "cwd": "${workspaceFolder}"
            },

            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },

            "problemMatcher": []
        }
    ]
}