{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SentinelAI: Setup Entorno",
            "type": "process",
            "command": "python",
            "windows": {
                "command": "py",
                "args": [
                    "-3",
                    "${workspaceFolder}/sentinel/setup_env.py"
                ]
            },
            "linux": {
                "command": "python3"
            },
            "osx": {
                "command": "python3"
            },
            "args": [
                "${workspaceFolder}/sentinel/setup_env.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
