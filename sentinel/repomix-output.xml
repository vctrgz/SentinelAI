    <script>
        const chatBox = document.getElementById("chat-box");
        const loading = document.getElementById("loading");

        // Detectar cambio en el desplegable
        document.getElementById("model-select").addEventListener("change", async (e) => {
            const selectedMode = e.target.value;
            
            // Opcional: Mostrar un mensaje visual de que el modelo está cambiando
            console.log("Cambiando a modo:", selectedMode);

            try {
                await fetch("/config-model", {
                    method: "POST",
                    headers: {"Content-Type": "application/json"},
                    body: JSON.stringify({ mode: selectedMode })
                });
            } catch (error) {
                console.error("Error al cambiar el modelo:", error);
            }
        });

        function appendMessage(role, text) {
            const msgDiv = document.createElement("div");
            msgDiv.className = role === 'user' 
                ? "message-user p-4 rounded-l-lg rounded-tr-lg max-w-[85%] ml-auto text-right" 
                : "message-agent p-4 rounded-r-lg rounded-tl-lg max-w-[85%]";
            
            // Convertimos saltos de línea y formateo básico de markdown
            const formattedText = text.replace(/\n/g, '<br>').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
            
            msgDiv.innerHTML = `<p class="text-sm">${formattedText}</p>`;
            chatBox.appendChild(msgDiv);
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        async function send() {
            const inputField = document.getElementById("input");
            const question = inputField.value.trim();
            if (!question) return;

            // Mostrar mensaje del usuario
            appendMessage('user', question);
            inputField.value = "";
            
            // Mostrar loading
            loading.classList.remove("hidden");

            try {
                const res = await fetch("/chat", {
                    method: "POST",
                    headers: {"Content-Type": "application/json"},
                    body: JSON.stringify({
                        question: question,
                    })
                });

                const data = await res.json();
                
                // Ocultar loading y mostrar respuesta
                loading.classList.add("hidden");
                appendMessage('agent', data.response);

            } catch (error) {
                loading.classList.add("hidden");
                appendMessage('agent', "❌ **Error de conexión:** No se pudo contactar con el servidor SOC. Verifica que el backend esté corriendo.");
                console.error(error);
            }
        }
    </script>
