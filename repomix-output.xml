  font-size:12px;color:var(--red);font-family:var(--mono);
  padding:8px 12px;border-radius:8px;
  background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);
  margin-bottom:16px;display:flex;align-items:center;gap:8px;
}
.sudo-error.hidden{display:none;}

.sudo-actions{display:flex;gap:10px;}
.sudo-cancel{
  flex:1;padding:12px;border-radius:12px;border:1px solid var(--border);
  background:rgba(255,255,255,.04);color:var(--muted);
  font-family:var(--font);font-size:14px;font-weight:500;
  cursor:pointer;transition:all .2s;
}
.sudo-cancel:hover{border-color:rgba(255,255,255,.15);color:var(--text);}
.sudo-submit{
  flex:2;padding:12px;border-radius:12px;border:none;
  background:linear-gradient(135deg,rgba(239,68,68,.8),rgba(168,85,247,.7));
  color:#fff;font-family:var(--font);font-size:14px;font-weight:600;
  cursor:pointer;transition:all .2s;
  box-shadow:0 4px 20px rgba(239,68,68,.2);
}
.sudo-submit:hover{transform:translateY(-1px);box-shadow:0 6px 24px rgba(239,68,68,.3);}
.sudo-submit:active{transform:translateY(0);}
.sudo-submit:disabled{opacity:.5;cursor:not-allowed;transform:none;}

.sudo-hint{
  font-size:11px;color:var(--muted);text-align:center;
  margin-top:14px;font-family:var(--mono);
}
</style>
</head>
<body>

<!-- ── Backgrounds ── -->
<div class="bg-scene">
  <div class="orb orb-1"></div><div class="orb orb-2"></div><div class="orb orb-3"></div>
</div>
<div class="bg-grid"></div>

<!-- ════════════════════════════════════════════════
     SUDO PASSWORD MODAL
     ════════════════════════════════════════════════ -->
<div class="sudo-overlay hidden" id="sudoOverlay">
  <div class="sudo-modal" role="dialog" aria-modal="true" aria-labelledby="sudoTitle">

    <div class="sudo-icon">🔐</div>
    <div class="sudo-title" id="sudoTitle">Autenticación sudo requerida</div>
    <div class="sudo-desc" id="sudoDesc">
      SentinelAI necesita permisos de superusuario para ejecutar herramientas de red
      como <strong>nmap</strong>. Introduce la contraseña de tu sistema para continuar.
    </div>

    <!-- Error message (hidden by default) -->
    <div class="sudo-error hidden" id="sudoError">
      <i class="fas fa-exclamation-triangle"></i>
      <span id="sudoErrorMsg">Contraseña incorrecta. Inténtalo de nuevo.</span>
    </div>

    <!-- Password field -->
    <div class="sudo-field">
      <label for="sudoInput">Contraseña del sistema</label>
      <div class="sudo-input-wrap">
        <input
          class="sudo-input"
          id="sudoInput"
          type="password"
          placeholder="••••••••••••"
          autocomplete="current-password"
          spellcheck="false"
        />
        <button class="sudo-toggle" id="sudoToggle" type="button" title="Mostrar/ocultar">
          <i class="fas fa-eye" id="sudoEyeIcon"></i>
        </button>
      </div>
    </div>

    <!-- Actions -->
    <div class="sudo-actions">
      <button class="sudo-cancel" id="sudoCancel">Cancelar</button>
      <button class="sudo-submit" id="sudoSubmit">
        <i class="fas fa-lock-open"></i>&ensp;Autenticar
      </button>
    </div>

    <div class="sudo-hint">La contraseña no se almacena permanentemente y se borra al cerrar la sesión.</div>
  </div>
</div>

<!-- ── Main app ── -->
<div class="app">
  <header>
    <div class="logo">
      <div class="logo-icon"><i class="fas fa-shield-halved"></i></div>
      <div class="logo-text">
        <span class="logo-name">SentinelAI</span>
        <span class="logo-sub">Cybersec Agent</span>
      </div>
    </div>
    <div class="header-controls">
      <select id="modelSelect" class="model-select">
        <option value="balanceado">⚖ Balanceado</option>
        <option value="defensivo">🛡 Defensivo</option>
        <option value="ofensivo">⚔ Ofensivo</option>
      </select>
      <div class="status-pill" id="statusPill">
        <div class="status-dot"></div>
        <span id="statusText">Conectando</span>
      </div>
    </div>
  </header>

  <div class="chat-wrap" id="chatWrap">
    <div class="typing" id="typing">
      <div class="tdot"></div><div class="tdot"></div><div class="tdot"></div>
    </div>
  </div>

  <div class="input-area">
    <div class="input-row">
      <input id="chatInput" class="chat-input" type="text"
        placeholder="Escribe tu consulta de seguridad…" autocomplete="off" spellcheck="false"/>
      <button class="send-btn" id="sendBtn"><i class="fas fa-arrow-up"></i></button>
    </div>
    <div class="input-hint"><span class="hint-key">Enter</span> para enviar</div>
  </div>
</div>

<script>
// ── DOM refs ──────────────────────────────────────────────────────────────────
const chatWrap   = document.getElementById('chatWrap');
const chatInput  = document.getElementById('chatInput');
const sendBtn    = document.getElementById('sendBtn');
const statusPill = document.getElementById('statusPill');
const statusText = document.getElementById('statusText');

// Sudo modal refs
const sudoOverlay  = document.getElementById('sudoOverlay');
const sudoInput    = document.getElementById('sudoInput');
const sudoSubmit   = document.getElementById('sudoSubmit');
const sudoCancel   = document.getElementById('sudoCancel');
const sudoToggle   = document.getElementById('sudoToggle');
const sudoEyeIcon  = document.getElementById('sudoEyeIcon');
const sudoError    = document.getElementById('sudoError');
const sudoErrorMsg = document.getElementById('sudoErrorMsg');
const sudoDesc     = document.getElementById('sudoDesc');

// ── Markdown renderer (lightweight) ──────────────────────────────────────────
function renderMarkdown(text) {
  return text
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/^### (.+)$/gm,'<h3>$1</h3>')
    .replace(/^## (.+)$/gm,'<h2>$1</h2>')
    .replace(/^# (.+)$/gm,'<h1>$1</h1>')
    .replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>')
    .replace(/`([^`]+)`/g,'<code>$1</code>')
    .replace(/^---$/gm,'<hr>')
    .replace(/^\|(.+)\|$/gm,(_, row) => {
      if (row.replace(/[-| ]/g,'').trim()==='') return null;
      const cells = row.split('|').map(c => c.trim());
      return '<tr>' + cells.map(c => `<td>${c}</td>`).join('') + '</tr>';
    })
    .replace(/((<tr>.*<\/tr>\n?)+)/g,'<table>$1</table>')
    .replace(/\n/g,'<br>');
}

// ── Chat helpers ──────────────────────────────────────────────────────────────
function addMsg(role, html) {
  const d = document.createElement('div');
  d.className = role === 'user' ? 'msg msg-user' : 'msg msg-agent';
  d.innerHTML = role === 'agent'
    ? `<div class="msg-label"><i class="fas fa-microchip"></i> SentinelAI</div><div>${html}</div>`
    : html;
  chatWrap.insertBefore(d, document.getElementById('typing'));
  chatWrap.scrollTop = chatWrap.scrollHeight;
  return d;
}

function addProgress(msg) {
  const d = document.createElement('div');
  d.className = 'msg-progress';
  d.innerHTML = `<div class="progress-spin"></div><span>${msg}</span>`;
  chatWrap.insertBefore(d, document.getElementById('typing'));
  chatWrap.scrollTop = chatWrap.scrollHeight;
  return d;
}

function setStatus(s) {
  statusPill.className = 'status-pill ' + s;
  statusText.textContent = {online:'Online', offline:'Sin LLM'}[s] || 'Conectando';
}

// ── Health check ──────────────────────────────────────────────────────────────
async function checkHealth() {
  try {
    const d = await (await fetch('/health')).json();
    if (d.status === 'ok') {
      setStatus('online');
      const m = d.models?.slice(0,3).join(', ') || 'ninguno';
      addMsg('agent', `Sistema listo. Modelos: <code>${m}</code>.<br>¿En qué puedo ayudarte hoy?`);
    } else {
      setStatus('offline');
      addMsg('agent', `⚠ Servidor degradado.`);
    }
  } catch {
    setStatus('offline');
    addMsg('agent', 'No se puede conectar con el servidor. ¿Está corriendo uvicorn?');
  }
}

// ════════════════════════════════════════════════════════════════════════════
// SUDO PASSWORD MODAL
// ════════════════════════════════════════════════════════════════════════════

function showSudoModal(message) {
  if (message) {
    sudoDesc.innerHTML = message.replace(/\n/g, '<br>');
  }
  sudoError.classList.add('hidden');
  sudoInput.value = '';
  sudoOverlay.classList.remove('hidden');
  sudoSubmit.disabled = false;
  // Focus the input after animation
  setTimeout(() => sudoInput.focus(), 120);
}

function hideSudoModal() {
  sudoOverlay.classList.add('hidden');
  sudoInput.value = '';
}

function showSudoError(msg) {
  sudoErrorMsg.textContent = msg || 'Contraseña incorrecta. Inténtalo de nuevo.';
  sudoError.classList.remove('hidden');
  // Shake the input
  sudoInput.classList.remove('shake');
  void sudoInput.offsetWidth; // reflow
  sudoInput.classList.add('shake');
  setTimeout(() => sudoInput.classList.remove('shake'), 400);
  sudoInput.value = '';
  sudoInput.focus();
}

// Toggle password visibility
sudoToggle.addEventListener('click', () => {
  const show = sudoInput.type === 'password';
  sudoInput.type = show ? 'text' : 'password';
  sudoEyeIcon.className = show ? 'fas fa-eye-slash' : 'fas fa-eye';
});

// Submit password
async function submitSudoPassword() {
  const pw = sudoInput.value.trim();
  if (!pw) { sudoInput.focus(); return; }

  sudoSubmit.disabled = true;
  sudoSubmit.innerHTML = '<i class="fas fa-spinner fa-spin"></i>&ensp;Verificando…';

  try {
    const resp = await fetch('/sudo-auth', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ password: pw }),
    });
    if (resp.ok) {
      hideSudoModal();
      // The executor thread is now unblocked; execution continues automatically
    } else {
      sudoSubmit.disabled = false;
      sudoSubmit.innerHTML = '<i class="fas fa-lock-open"></i>&ensp;Autenticar';
      showSudoError('Error al enviar la contraseña. Inténtalo de nuevo.');
    }
  } catch (err) {
    sudoSubmit.disabled = false;
    sudoSubmit.innerHTML = '<i class="fas fa-lock-open"></i>&ensp;Autenticar';
    showSudoError('Error de conexión: ' + err.message);
  }
}

sudoSubmit.addEventListener('click', submitSudoPassword);
sudoCancel.addEventListener('click', hideSudoModal);
sudoInput.addEventListener('keydown', e => {
  if (e.key === 'Enter') { e.preventDefault(); submitSudoPassword(); }
  if (e.key === 'Escape') hideSudoModal();
});
// Close modal on overlay click (outside the modal box)
sudoOverlay.addEventListener('click', e => {
  if (e.target === sudoOverlay) hideSudoModal();
});

// ── Streaming chat send ───────────────────────────────────────────────────────
async function send() {
  const q = chatInput.value.trim();
  if (!q || sendBtn.disabled) return;

  addMsg('user', q.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'));
  chatInput.value = '';
  sendBtn.disabled = true;

  let progressEl = addProgress('🔍 Procesando solicitud…');

  try {
    const resp = await fetch('/chat', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ question: q }),
    });

    if (!resp.ok) {
      const j = await resp.json();
      progressEl.remove();
      addMsg('agent', `❌ Error: ${j.response || resp.statusText}`);
      return;
    }

    const reader  = resp.body.getReader();
    const decoder = new TextDecoder();
    let buf = '';

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      buf += decoder.decode(value, { stream: true });

      const lines = buf.split('\n');
      buf = lines.pop();   // keep incomplete line

      for (const line of lines) {
        if (!line.startsWith('data: ')) continue;
        try {
          const ev = JSON.parse(line.slice(6));

          if (ev.type === 'ping') {
            const span = progressEl.querySelector('span');
            if (span) span.textContent = ev.message;

          } else if (ev.type === 'needs_sudo') {
            // Show the sudo password modal — the executor thread is blocked waiting
            const span = progressEl.querySelector('span');
            if (span) span.textContent = '🔐 Esperando autenticación sudo…';
            showSudoModal(ev.message);

          } else if (ev.type === 'done') {
            hideSudoModal();   // safety: close modal if still open
            progressEl.remove();
            addMsg('agent', renderMarkdown(ev.response || '(sin respuesta)'));

          } else if (ev.type === 'error') {
            hideSudoModal();
            progressEl.remove();
            addMsg('agent', `❌ ${ev.response}`);
          }
        } catch (_) { /* ignore parse errors */ }
      }
    }

  } catch (err) {
    progressEl.remove();
    addMsg('agent', `❌ Error de conexión: <code>${err.message}</code><br>
      Para scans de red largos, espera — el servidor sigue procesando.`);
  } finally {
    sendBtn.disabled = false;
    chatInput.focus();
  }
}

chatInput.addEventListener('keydown', e => {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
});
sendBtn.addEventListener('click', send);

document.getElementById('modelSelect').addEventListener('change', async e => {
  try {
    await fetch('/config-model', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ mode: e.target.value }),
    });
  } catch(err) { console.error('Model change failed:', err); }
});

// ── Init ──────────────────────────────────────────────────────────────────────
checkHealth();
chatInput.focus();
</script>
</body>
</html>
</file>

